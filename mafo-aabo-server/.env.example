# MAFO AABO Trust™ — environment
# Copy to .env and fill in. NEVER commit .env.

NODE_ENV=development
PORT=3002

# PostgreSQL (dedicated database — trust records are NOT mixed with the member platform)
DATABASE_URL=postgresql://mafo:CHANGE_ME@localhost:5432/mafo_aabo

# Session signing secret (generate: openssl rand -hex 32)
SESSION_SECRET=CHANGE_ME

# Trust hostname (used for CORS default)
TRUST_DOMAIN=trust.solvy.cards

# Optional: comma-separated extra CORS origins
# ALLOWED_ORIGINS=https://trust.solvy.cards,https://trust.solvy.cards

# Optional: override static frontend directory (defaults to ../solvy-platform/mafo-aabo)
# WEB_DIR=/var/www/trust.solvy.cards

# Document vault — AES-256-GCM key (generate: openssl rand -hex 32)
DOC_ENCRYPTION_KEY=CHANGE_ME_64_HEX_CHARS

# Encrypted files live OUTSIDE the web root (default ./uploads)
# UPLOAD_DIR=/var/lib/mafo-aabo-uploads

# Seed-time only — real per-person access codes, passed via env, never committed:
# SEED_CODE_TRUSTEE=...
# SEED_CODE_GRANTOR=...
# SEED_CODE_BENEFICIARY=...
